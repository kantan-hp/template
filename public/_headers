/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

/admin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://api.github.com; frame-ancestors 'none'

# Pages canonicalizes /admin to the trailing-slash /admin/, and an exact
# /admin rule matches only the 308 redirect. The splat below is what actually
# covers the served CMS page (and subpaths); keep /admin above to also harden
# the redirect. img-src includes blob: because Sveltia's media library renders
# unsaved-upload thumbnails via URL.createObjectURL(). font-src admits
# cdn.jsdelivr.net because Sveltia injects @font-face rules (Material Symbols
# Outlined icon font + Noto Mono) pointing there — without it the icon glyphs
# fail to render and the editor shows only bare text labels.
/admin/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://api.github.com; frame-ancestors 'none'

/admin/lang.js
  # lang.js is re-read on every load (the provisioner/owner can change the
  # editor language any time) — don't let the 4h static-asset default cache it.
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
