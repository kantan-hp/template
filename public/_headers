/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

/admin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'

# Pages canonicalizes /admin to the trailing-slash /admin/, and an exact
# /admin rule matches only the 308 redirect. The splat below is what actually
# covers the served CMS page (and subpaths); keep /admin above to also harden
# the redirect. img-src includes blob: because Sveltia's media library renders
# unsaved-upload thumbnails via URL.createObjectURL().
/admin/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
