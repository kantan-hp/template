/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

/admin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
