---
// Layout for a single blog post.
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { site } from '../config';
import { ui } from '../i18n/ui';
import { defaultLocale } from '../i18n/ui';
import { jsonLd } from '../lib/seo';
import { safeUrl } from '../lib/url';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const t = ui[defaultLocale];
const { Content } = await render(post);
const blogUrl = '/blog/';
const formattedDate = post.data.pubDate.toLocaleDateString(defaultLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Hero URL after the scheme allowlist. Only render an <img> when the survived
// value is a real URL: safeUrl collapses unsafe values to '/' (a broken image
// if rendered as src), and mailto/tel/# are nonsense in an img src.
const heroSrc = post.data.heroImage ? safeUrl(post.data.heroImage) : null;
const hasHero =
  heroSrc != null &&
  heroSrc !== '/' &&
  !/^(?:mailto:|tel:|#)/i.test(heroSrc);

// BlogPosting structured data, only once a real site URL resolves.
const siteUrl = Astro.site;
const hasRealSite =
  Boolean(siteUrl) && !(import.meta.env.SITE ?? '').includes('your-site.example.com');
const postUrl = hasRealSite ? new URL(Astro.url.pathname, siteUrl!).href : undefined;
const blogPostingJsonLd = hasRealSite
  ? jsonLd({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      author: { '@type': 'Person', name: site.author },
      ...(postUrl ? { mainEntityOfPage: postUrl, url: postUrl } : {}),
    })
  : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.heroImage ? safeUrl(post.data.heroImage) : undefined}
>
  <Fragment slot="head">
    {post.data.pubDate && (
      <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    )}
    {post.data.updatedDate && (
      <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />
    )}
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {blogPostingJsonLd && <script is:inline type="application/ld+json" set:html={blogPostingJsonLd} />}
  </Fragment>

  <div class="container">
    <article class="post">
      <a class="back-link" href={blogUrl}>{t.post.backToBlog}</a>
      <header>
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formattedDate}
          </time>
          {post.data.tags.map((tag) => <Tag text={tag} />)}
        </div>
      </header>
      {hasHero && (
        <img
          class="post-hero"
          src={heroSrc}
          alt={post.data.title}
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
        />
      )}
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
