---
// Base layout for every page: shared <head>, header, footer and content slot.
// The theme preset (from the Settings tab) is baked in as `data-preset`;
// light/dark is resolved at runtime before paint (FOUC-prevention script).
import '../styles/global.css';
import { site, theme, themeColor } from '../config';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import { defaultLocale, locales } from '../i18n/ui';
import {
  getLanguageFromLocale,
  getLocaleFromUrl,
  getLocalizedUrl,
  getPathWithoutLocale,
} from '../i18n/utils';
import { jsonLd } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Main from '../components/Main.astro';

interface Props {
  title?: string;
  description?: string;
  // When set, the footer language switcher links from this path instead of the
  // current one. The 404 page uses '/' so the switcher always lands on a real
  // locale page.
  langSwitchBase?: string;
  // Open Graph object type; posts pass 'article'.
  ogType?: string;
  // Site-relative (or absolute) share image. Posts pass their heroImage; the
  // site-wide default share image ships with the logo plan.
  ogImage?: string;
  // Locales that have a page at this path (hreflang alternates). Site-level
  // pages exist in every locale; posts pass only their translated locales.
  hreflangLocales?: Locale[];
}

const {
  title,
  description,
  langSwitchBase,
  ogType = 'website',
  ogImage,
  hreflangLocales,
} = Astro.props;
const locale: Locale = getLocaleFromUrl(Astro.url);
const t = ui[locale];
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const pageDescription = description ?? site.description;
const rssUrl = getLocalizedUrl('/rss.xml', locale);

// Canonical / og:url / hreflang / JSON-LD are only meaningful once a real site
// URL is configured (PUBLIC_SITE_URL or site.url). Until then `site` falls back
// to the placeholder, which would point crawlers at a nonexistent domain — so
// omit these tags instead of emitting the placeholder.
const siteUrl = Astro.site;
const resolvedSite = import.meta.env.SITE ?? '';
const hasRealSite = Boolean(siteUrl) && !resolvedSite.includes('your-site.example.com');
const canonicalURL = hasRealSite ? new URL(Astro.url.pathname, siteUrl!).href : undefined;

// hreflang alternates; x-default points at the default locale's URL when that
// locale actually has the page, otherwise at the page's own locale (the only
// locale guaranteed to have it).
const pagePath = getPathWithoutLocale(Astro.url.pathname);
const alternates: Locale[] = hreflangLocales ?? [...locales];
const xDefaultLocale: Locale = alternates.includes(defaultLocale) ? defaultLocale : locale;
const hreflang = hasRealSite
  ? [
      ...alternates.map((l) => ({
        lang: l,
        href: new URL(getLocalizedUrl(pagePath, l), siteUrl!).href,
      })),
      {
        lang: 'x-default',
        href: new URL(getLocalizedUrl(pagePath, xDefaultLocale), siteUrl!).href,
      },
    ]
  : [];

// Share image (og:image / twitter:image), absolutized once a real site resolves.
const ogImageUrl =
  hasRealSite && ogImage
    ? (/^https?:\/\//.test(ogImage) ? ogImage : new URL(ogImage, siteUrl!).href)
    : undefined;

// Homepage (root or a locale root) carries WebSite structured data; posts add
// BlogPosting from PostLayout via the head slot.
const isHome = getPathWithoutLocale(Astro.url.pathname) === '/';
const websiteJsonLd =
  hasRealSite && isHome
    ? jsonLd({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.title,
        description: site.description,
        url: new URL('/', siteUrl!).href,
      })
    : undefined;
---

<!doctype html>
<html lang={getLanguageFromLocale(locale)} data-preset={theme.preset}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.author} />
    <meta name="generator" content={Astro.generator} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={rssUrl} />
    <meta name="theme-color" content={themeColor} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:locale" content={locale} />
    {alternates
      .filter((l) => l !== locale)
      .map((l) => <meta property="og:locale:alternate" content={l} />)}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- hreflang alternates + x-default (only when a real site URL resolves) -->
    {hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}

    <!-- WebSite structured data on the homepage -->
    {websiteJsonLd && <script is:inline type="application/ld+json" set:html={websiteJsonLd} />}

    <!-- Page-specific meta / structured data (posts) -->
    <slot name="head" />

    <!--
      Inline FOUC-prevention script: applies the stored (or OS-preferred)
      light/dark theme to <html> before the browser paints.
    -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skipToContent}</a>
    <Header />
    <Main>
      <slot />
    </Main>
    <Footer langSwitchBase={langSwitchBase} hreflangLocales={hreflangLocales} />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
