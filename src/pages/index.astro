---
// Homepage.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>Kantan HP</h1>
      <p>
        A lightweight <strong>Astro + Decap CMS</strong> blog starter, ready to
        publish on Cloudflare Pages. Manage everything from the <code>/admin</code> dashboard.
      </p>
    </div>
  </section>

  <div class="container admin-note">
    <strong>Editors:</strong> go to <a href="/admin">/admin</a>, log in with your
    GitHub account, and start writing. Saved posts are published automatically.
  </div>
</BaseLayout>
