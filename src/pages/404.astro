---
// 404 page. NOTE (static builds): with `output: 'static'` this page is
// pre-rendered ONCE to /404.html at build time, when `Astro.url` has no locale
// prefix — so `getLocaleFromUrl` resolves to the site's default locale and the
// deployed 404 is always in the default language. Per-locale 404 strings only
// happen in `astro dev`/SSR, where `Astro.url` reflects the request. On static
// hosts a missing /ja/... path serves this default-locale 404; the footer
// language switcher (langSwitchBase="/") still links visitors to each locale's
// home, so the graceful path is preserved regardless.
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import { getLocaleFromUrl, getLocalizedUrl } from '../i18n/utils';

const locale: Locale = getLocaleFromUrl(Astro.url);
const t = ui[locale];
const homeUrl = getLocalizedUrl('/', locale);
---

<BaseLayout title={t.notFound.title} langSwitchBase="/">
  <div class="container notfound">
    <h1>404</h1>
    <p class="muted">{t.notFound.body}</p>
    <a class="btn" href={homeUrl}>{t.notFound.goHome}</a>
  </div>
</BaseLayout>
