---
// English blog index at /blog/, paginated. Page 1 lives at /blog/ and later
// pages at /blog/page/N/ so pagination URLs never collide with post slugs in
// blog/[slug].astro (a post numbered "2" would otherwise clash with /blog/2/).
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { site } from '../../config';
import { ui } from '../../i18n/ui';
import type { Locale } from '../../i18n/ui';
import { blogIndexPaths, getPostsFor } from '../../lib/blog';

export const getStaticPaths: GetStaticPaths = async () =>
  blogIndexPaths(await getPostsFor('en'));

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  lastPage: number;
  locale: Locale;
}

const { posts, currentPage, lastPage, locale } = Astro.props as Props;
const t = ui[locale];
---

<BaseLayout title={t.blog.title} description={t.blog.description(site.title)}>
  <BlogIndex posts={posts} currentPage={currentPage} lastPage={lastPage} locale={locale} />
</BaseLayout>
