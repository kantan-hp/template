---
// Blog index for the non-default locales (/ja/blog/, ...), paginated.
// Page 1 lives at /<locale>/blog/ and later pages at /<locale>/blog/page/N/
// so pagination URLs never collide with post slugs in blog/[slug].astro.
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import { site } from '../../../config';
import { ui } from '../../../i18n/ui';
import type { Locale } from '../../../i18n/ui';
import { blogIndexPaths, getPostsFor, nonDefaultLocales } from '../../../lib/blog';

export const getStaticPaths: GetStaticPaths = async () => {
  const locales = nonDefaultLocales();
  const perLocale = await Promise.all(locales.map((locale) => getPostsFor(locale)));
  return locales.flatMap((locale, i) => blogIndexPaths(perLocale[i], locale));
};

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  lastPage: number;
  locale: Locale;
}

const { posts, currentPage, lastPage, locale } = Astro.props as Props;
const t = ui[locale];
---

<BaseLayout title={t.blog.title} description={t.blog.description(site.title)}>
  <BlogIndex posts={posts} currentPage={currentPage} lastPage={lastPage} locale={locale} />
</BaseLayout>
