---
// Renders a blog post's publication date as a <time> element, localized to
// the site's language.
import { defaultLocale } from '../i18n/ui';

interface Props {
  date: Date;
}

const { date } = Astro.props;

const formatted = date.toLocaleDateString(defaultLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<time datetime={date.toISOString()}>{formatted}</time>
