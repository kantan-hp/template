---
// Homepage body. Hero copy is localized to the site's language; the site
// title/tagline come from Settings.
import Card from './Card.astro';
import { site } from '../config';
import { ui } from '../i18n/ui';
import { defaultLocale } from '../i18n/ui';
import { getAllPosts } from '../lib/blog';

const t = ui[defaultLocale];
const posts = (await getAllPosts()).slice(0, 4);
const blogUrl = '/blog/';
---

<div class="container">
  <section class="hero">
    <h1>{site.title}</h1>
    <p class="tagline">{site.description}</p>
    <div class="cta">
      <a class="btn" href={blogUrl}>{t.hero.readBlog}</a>
      <a class="btn btn-ghost" href="/admin">{t.hero.openEditor}</a>
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2>{t.hero.latestPosts}</h2>
      <a href={blogUrl}>{t.hero.viewAll}</a>
    </div>
    {
      posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => <Card post={post} />)}
        </ul>
      ) : (
        <p class="muted">
          {t.hero.noPostsBefore} <a href="/admin">/admin</a> {t.hero.noPostsAfter}
        </p>
      )
    }
  </section>
</div>
