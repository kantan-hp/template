---
// Shared page header: brand, nav (from the Settings tab) and theme toggle.
// Nav labels are translated when they match the default labels; custom labels
// show as authored. Internal nav URLs are locale-aware.
import { site, nav } from '../config';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import { getLocaleFromPath, getLocalizedUrl } from '../i18n/utils';

const locale: Locale = getLocaleFromPath(Astro.url.pathname);
const t = ui[locale];

const current = Astro.url.pathname;

const isActive = (path: string) => {
  const localized = getLocalizedUrl(path, locale);
  if (localized === '/') return current === '/';
  return current === localized || current.startsWith(`${localized}/`);
};

const navHref = (url: string) => {
  if (url.startsWith('/') && !url.startsWith('//')) return getLocalizedUrl(url, locale);
  return url;
};
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={getLocalizedUrl('/', locale)}>{site.title}</a>
    <nav class="site-nav" aria-label={t.navLabel}>
      {
        nav.map((item) => (
          <a
            href={navHref(item.url)}
            aria-current={isActive(item.url) ? 'page' : undefined}
          >
            {t.nav[item.label] ?? item.label}
          </a>
        ))
      }
      <button
        id="theme-toggle"
        class="theme-toggle"
        aria-label={t.themeToggle}
        title={t.themeToggle}
      >
        <svg
          class="icon-sun"
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg
          class="icon-moon"
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
        </svg>
      </button>
    </nav>
  </div>
</header>
