---
// About page body. Renders the about entry (see getAbout).
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { ui } from '../i18n/ui';
import { defaultLocale } from '../i18n/ui';

interface Props {
  about: CollectionEntry<'pages'> | undefined;
}

const { about } = Astro.props;
const t = ui[defaultLocale];
const renderProps = about ? await render(about) : null;
const title = about?.data.title ?? t.nav.About;
---

<div class="container" style="padding-top:2rem">
  {
    renderProps ? (
      <article>
        <h1>{title}</h1>
        <div class="prose">
          <renderProps.Content />
        </div>
      </article>
    ) : (
      <p class="muted">{t.about.notWritten}</p>
    )
  }
</div>
