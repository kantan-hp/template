---
// Newer/older links for the paginated blog index.
import { ui } from '../i18n/ui';
import { defaultLocale } from '../i18n/ui';

interface Props {
  page: number;
  totalPages: number;
}

const { page, totalPages } = Astro.props;
const t = ui[defaultLocale];

const prevHref = page > 1 ? (page === 2 ? '/blog/' : `/blog/page/${page - 1}/`) : null;
const nextHref = page < totalPages ? `/blog/page/${page + 1}/` : null;
---

<nav class="pagination" aria-label={t.pagination.ariaLabel}>
  {prevHref ? (
    <a href={prevHref}>{t.pagination.newer}</a>
  ) : (
    <span class="disabled" aria-disabled="true">{t.pagination.newer}</span>
  )}
  {nextHref ? (
    <a href={nextHref}>{t.pagination.older}</a>
  ) : (
    <span class="disabled" aria-disabled="true">{t.pagination.older}</span>
  )}
</nav>
